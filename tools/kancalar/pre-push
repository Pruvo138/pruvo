#!/bin/sh
# PRUVO pre-push — IZLENEN KANCA KAYNAGI (tools/kancalar/pre-push).
# Kurulum: python3 tools/kanca-kur.py (izlenen kaynak ORTAK `.git/pruvo-kancalar/`a
# kopyalanir, core.hooksPath o kopyanin MUTLAK yoluna baglanir).

# --- 0) KOPYA TAZELIGI (FAIL-CLOSED, DELIK 1) -------------------------------
# `git pull` izlenen kaynagi guncelleyince kurulan KOPYA bayat kalir ve bu kanca
# (kopyadan kosan) SESSIZCE eski mantigi calistirir. `--tazele` kopya bayatsa
# yeniden serer; rc 3 -> PUSH'u DURDUR, sonraki push taze mantikla kosar.
# stdin'e DOKUNMAZ (asagidaki geri-donus blogu ref listesini okur).
pruvo_pp_kok=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$pruvo_pp_kok" ] && [ -f "$pruvo_pp_kok/tools/kanca-kur.py" ]; then
  python3 "$pruvo_pp_kok/tools/kanca-kur.py" --tazele </dev/null
  pruvo_pp_tazele_rc=$?
  if [ "$pruvo_pp_tazele_rc" = "3" ]; then
    echo "!! PUSH DURDURULDU — kurulu kanca kopyasi BAYATTI ve tazelendi. Tekrar push et." >&2
    exit 1
  elif [ "$pruvo_pp_tazele_rc" != "0" ]; then
    echo "!! PUSH DURDURULDU — kanca kopyasi tazelenemedi (rc=$pruvo_pp_tazele_rc)." >&2
    exit 1
  fi
fi

# --- 0b) CI KAPSAM KAPISI (FAIL-CLOSED, 9 Agu 2026) -------------------------
# OLCULEN KORLUK: yeni bir `tools/<x>-kapisi.py` yazip `git add` ETMEDEN kapiyi
# kosan mimar rc=0 "SONUC: YESIL ✅" aliyordu; kirmizi ancak push'tan SONRA
# nobet.yml'de konusuyordu (katalog-alan-kapisi.py partisinde FIILEN yasandi).
# Kapinin kesfi artik izlenmeyen calisma-agaci dosyalarini da kapsiyor; BU BLOK
# geri bildirimi CI'dan PUSH ANINA ceker. Ikisi AYRI eksendir: blok tek basina
# korlugu KAPATMAZ (commit aninda dosya ZATEN `git ls-files`tadir — olculdu,
# sentetik depoda ADIM 3 `--others`=[] verdi), kesif genislemesi olmadan bu blok
# yalniz "CI'da gorecegini erken gor" der.
# OLCULEN MALIYET: medyan 3,16 sn (3 kosum, 9 Agu 2026; taban 2,99 sn) -> 5 sn
# esiginin ALTINDA, push'a eklenen bedel kabul edilebilir.
# FAIL-CLOSED: rc != 0 -> PUSH DURUR. Bilincli atlama: `git push --no-verify`.
# Git'in verdigi ref/SHA satirlari gecici dosyaya ALINIR; kapsam kapisi bu girdiden
# push araligini turetir, sonra stdin asagidaki sizinti kapisi ve D1 senkronu icin
# AYNEN geri acilir. Kapsam bilgisi okunamazsa kapi fail-closed davranir.
# SESSIZ CALISIR: kapi yesilse 193 satirlik envanter basilmaz, yalniz kirmizida
# tam cikti dokulur.
# 🔴 BAYRAKSIZ KOSAR (PAZARLIKSIZ): `--kendini-test` kolu GERCEK calisma agacini HIC
# olcmez (olculdu 9 Agu: agacta 3 izlenmeyen+kapsamsiz dosya varken bayraksiz kol
# rc=1, `--kendini-test` rc=0). Cagriyi o kola cevirmek push kapisini, eklendigi
# korlugu gormeyen bir kola indirger. `pre_push_kablo_kontrol()` bunu olcer.
# 🔴 ARAC YOKSA DA DURUR (kardes `gecmis-geri-donus` blogu ile SIMETRI): "kapiyi
# kosamadim" sessizce "kapi yesil" DEMEK DEGILDIR.
pruvo_kapsam_kok=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$pruvo_kapsam_kok" ] || [ ! -f "$pruvo_kapsam_kok/tools/ci-kapsam-test.py" ]; then
  echo "!! PUSH DURDURULDU — CI KAPSAM KAPISI KOSULAMADI (tools/ci-kapsam-test.py yok)." >&2
  echo "!! Kapsam kapisi fail-closed'dir. Kasten atlamak icin: git push --no-verify" >&2
  exit 1
fi
pruvo_kapsam_girdi=$(mktemp 2>/dev/null)
if [ -z "$pruvo_kapsam_girdi" ] || [ ! -f "$pruvo_kapsam_girdi" ]; then
  echo "!! PUSH DURDURULDU — pre-push ref/SHA girdisi icin gecici dosya acilamadi." >&2
  exit 1
fi
trap 'rm -f "$pruvo_kapsam_girdi"' EXIT HUP INT TERM
cat > "$pruvo_kapsam_girdi"
pruvo_kapsam_cikti=$(python3 "$pruvo_kapsam_kok/tools/ci-kapsam-test.py" --pre-push 2>&1 < "$pruvo_kapsam_girdi")
pruvo_kapsam_rc=$?
if [ "$pruvo_kapsam_rc" -ne 0 ]; then
  printf '%s
' "$pruvo_kapsam_cikti"
  echo "!! PUSH DURDURULDU — CI KAPSAM KAPISI KIRMIZI (rc=$pruvo_kapsam_rc)." >&2
  echo "!! Yukarida 'KAPSAMSIZ' ve 'HENUZ IZLENMIYOR (kapsamsiz)' satirlarina bak." >&2
  echo "!! COZUM: cagri satirini OTOMATIK bir is akisina ekle YA DA IZIN_LISTESI'ne" >&2
  echo "!!        GEREKCELI muafiyet yaz. 'HENUZ IZLENMIYOR' ise dosya daha `git add`" >&2
  echo "!!        edilmemis demektir — add etmek etiketi degistirir, sorunu KAPATMAZ." >&2
  echo "!! Bilerek atlamak icin: git push --no-verify (gurultulu ve kayitli)." >&2
  exit 1
fi
exec < "$pruvo_kapsam_girdi"
rm -f "$pruvo_kapsam_girdi"
trap - EXIT HUP INT TERM

# --- 0c) YENI CI ADIMI HUKUM KAPISI (FAIL-CLOSED, K80, 14 Agu 2026) --------
# Workflow'a yeni eklenen run komutunu VAR diye saymak yetmez: push edilen commit
# agacinda FIILEN rc=0 vermelidir. YAML agaci strategy.matrix degerlerini de acar.
# Ag/secret/kabuk yorumuna muhtac komut OLCULEMEDI (rc=2) olur, sessizce yesil sayilmaz.
pruvo_k80_girdi=$(mktemp 2>/dev/null)
if [ -z "$pruvo_k80_girdi" ] || [ ! -f "$pruvo_k80_girdi" ]; then
  echo "!! PUSH DURDURULDU — K80 pre-push girdisi icin gecici dosya acilamadi." >&2
  exit 1
fi
trap 'rm -f "$pruvo_k80_girdi"' EXIT HUP INT TERM
cat > "$pruvo_k80_girdi"
python3 "$pruvo_kapsam_kok/tools/is-akisi-kapisi.py" --pre-push < "$pruvo_k80_girdi"
pruvo_k80_rc=$?
if [ "$pruvo_k80_rc" -ne 0 ]; then
  echo "!! PUSH DURDURULDU — YENI CI ADIMI HUKMU KIRMIZI/OLCULEMEDI (rc=$pruvo_k80_rc)." >&2
  exit 1
fi
exec < "$pruvo_k80_girdi"
rm -f "$pruvo_k80_girdi"
trap - EXIT HUP INT TERM

# --- WORKTREE TAVAN NOBETI (RAPOR-ONLY; ASLA BLOKLAMAZ) ---------------------
# Yerel worktree envanteri CI'da anlamsizdir; yalniz bu makinede gorunurluk verir.
# Nobetci hata verse bile bu adim push sonucunu ETKILEMEZ.
if [ -n "$pruvo_kapsam_kok" ] && [ -f "$pruvo_kapsam_kok/tools/worktree-tavan-nobeti.py" ]; then
  if python3 "$pruvo_kapsam_kok/tools/worktree-tavan-nobeti.py"; then
    :
  else
    echo "!! WORKTREE TAVAN NOBETI hata verdi (push DEVAM ediyor)."
  fi
fi

# >>> PRUVO GECMIS GERI-DONUS NOBETI BLOGU (tools/gecmis-geri-donus-hook-kur.py uretir — ELLE DUZENLEME) >>>
# FAIL-CLOSED: bu itme temizlenmis sizintiyi (mesaj YA DA icerik ekseni) GERI
# GETIRIYORSA PUSH DURUR. Gerekce: tools/gecmis-geri-donus-hook-kur.py basligi.
pruvo_gd_kok=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$pruvo_gd_kok" ] || [ ! -f "$pruvo_gd_kok/tools/gecmis-geri-donus-kapisi.py" ]; then
  echo "!! GECMIS GERI-DONUS NOBETI KOSULAMADI (tools/gecmis-geri-donus-kapisi.py yok) — PUSH DURDURULDU."
  echo "!! Sizinti kapisi fail-closed'dir. Kasten atlamak icin: git push --no-verify"
  exit 1
fi
# 🔴 RC'YE GORE AYRI HUKUM (5 Agu 2026 olculen yanlis-atif): rc 1 ile rc 2 AYNI
# metni basmak YANLIS TESHIS uretir. Olculdu: butce asimindan gelen rc=2 "sizinti
# geri geliyor" diye okundu; bagimsiz TAM tarama 0 bulgu verdi. Kapinin sozlesmesi:
#   rc 1 = SIZINTI (gercek bulgu) · rc 2 = OLCULEMEDI (fail-closed, bulgu DEGIL).
# 🔴 MESAJ SECIMI FONKSIYONDA: rc yakalandiktan SONRAKI kod KISA kalmalidir; yoksa
# `exit` cagrisi kablolama nobetcisinin (tools/kanca-kablolama-nobeti.py) fail-open
# penceresinin DISINA taşar ve rc "okunup atiliyor" diye KIRMIZI yanar (bu olculdu).
pruvo_gd_mesaj() {
  if [ "$1" = "1" ]; then
    echo "!! PUSH DURDURULDU — SIZINTI (rc=1): bu itme temizlenmis sizintiyi GERI GETIRIYOR."
    echo "!! Yukaridaki kapi ciktisi hangi commit/eksende oldugunu yazar."
  elif [ "$1" = "2" ]; then
    echo "!! PUSH DURDURULDU — hukum OLCULEMEDI (rc=2, fail-closed)."
    echo "!! ⚠️ BU 'SIZINTI VAR' DEMEK DEGILDIR: kapi tarayamadigi icin yesil diyemedi."
    echo "!! Sebep: aday butcesi asildi (itmenin menzili patolojik genislikte)."
    echo "!! COZUM: itmeyi daha kucuk parcalara bol; ya da bilerek atlamak icin"
    echo "!!        'git push --no-verify' (gurultulu ve kayitli)."
  else
    echo "!! PUSH DURDURULDU — nobetci BEKLENMEDIK cikis verdi (rc=$1)."
    echo "!! Bu ne SIZINTI ne de bilinen bir OLCULEMEDI hukmudur; ciktiyi oku."
  fi
}
# STDIN'i al, kapiyi ondan besle, sonra kalan kancaya AYNEN geri ver (D1 senkronu
# ayni stdin'i okur — tuketip birakmak onu sessizce oldururdu).
pruvo_gd_girdi=$(mktemp 2>/dev/null || echo /tmp/pruvo-gd-$$)
cat > "$pruvo_gd_girdi"
python3 "$pruvo_gd_kok/tools/gecmis-geri-donus-kapisi.py" --pre-push < "$pruvo_gd_girdi"
pruvo_gd_rc=$?
# FAIL-CLOSED DEGISMEDI: rc ne olursa olsun (1 de 2 de) `exit 1` -> push DURUR.
if [ "$pruvo_gd_rc" -ne 0 ]; then
  rm -f "$pruvo_gd_girdi"
  pruvo_gd_mesaj "$pruvo_gd_rc"
  exit 1
fi
exec < "$pruvo_gd_girdi"
rm -f "$pruvo_gd_girdi"
# <<< PRUVO GECMIS GERI-DONUS NOBETI BLOGU <<<
# >>> PRUVO YEDEK BLOGU (tools/yedek-hook-kur.py uretir — ELLE DUZENLEME) >>>
# FAIL-OPEN: yedek patlasa/Drive olmasa bile push ASLA durmaz (blokta 'exit' YOK).
# UCUZ: --gerekliyse son damgadan beri degisiklik yoksa tek dosya bile kopyalamaz.
# Gorunurluk: python3 tools/durum.py  -> "7) YEDEK TAZELIGI"
pruvo_kok=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$pruvo_kok" ] && [ -f "$pruvo_kok/tools/yedekle.py" ]; then
  if ! python3 "$pruvo_kok/tools/yedekle.py" --gerekliyse >/dev/null 2>&1; then
    echo "!! YEDEK alinamadi (push DEVAM ediyor) — kontrol: python3 tools/durum.py"
  fi
fi
# --- ORTAK POSTA KUTUSU ARSIVI (tools/kutu-arsivle.py) ---
# NEDEN BURADA (31 Tem olcumu): arac dogru calisir halde geldi ama HICBIR YERDEN
# cagrilmiyordu. Tetiklenmeyen bir hijyen araci hicbir kapida kirmizi yakmaz -> sessizce
# olur (bugun ayni sinif "hic kosmayan cron" olarak da olculdu). yedekle.py ile AYNI
# kanca, AYNI desen, JETONSUZ.
# FAIL-OPEN (pazarliksiz): arac patlasa, kilit baskasinda olsa, python3 bulunmasa bile
# PUSH DEVAM EDER — bu bir HIJYEN araci, YAYIN KAPISI degil (blokta 'exit' YOK).
# IDEMPOTENT + UCUZ: tavan altindaysa hicbir sey yazmaz.
# GORUNUR: her push'a 6 satir gurultu basilmaz; yalniz ANLAMLI satir (YAZILDI/UYARI),
# basarisizlikta ise uyari + tani kuyrugu basilir.
if [ -n "$pruvo_kok" ] && [ -f "$pruvo_kok/tools/kutu-arsivle.py" ]; then
  pruvo_kutu_cikti=$(python3 "$pruvo_kok/tools/kutu-arsivle.py" 2>&1)
  pruvo_kutu_rc=$?
  if [ "$pruvo_kutu_rc" -ne 0 ]; then
    echo "!! POSTA KUTUSU arsivlenemedi (rc=$pruvo_kutu_rc, push DEVAM ediyor) — kontrol: python3 tools/kutu-arsivle.py --kuru"
    printf '%s
' "$pruvo_kutu_cikti" | tail -3
  else
    printf '%s
' "$pruvo_kutu_cikti" | grep -E '^(YAZILDI|UYARI)' || true
  fi
fi
# <<< PRUVO YEDEK BLOGU <<<
# urunler.json main'e push edilirken D1'i OTOMATIK senkronla.
#
# NEDEN VAR: Ege (WhatsApp botu) urunleri artik urunler.json'dan degil D1'DEN okuyor
# (2026-07-15, Faz 2). D1 senkronlanmazsa SITE yeni urunu gosterir ama EGE GOREMEZ —
# musteriye "yok" demez ama urunu de oneremez = sessiz satis kaybi. Bunu insanin
# hatirlamasina birakmak = er ya da gec unutulur.
#
# NEDEN TOKEN GEREKMIYOR: yerelde wrangler KENDI oturumunu kullanir. Actions'taki
# senkron adimi CLOUDFLARE_API_TOKEN'da D1 yetkisi olmadigi icin hata veriyor
# (code 10000); bu hook o adima olan ihtiyaci ortadan kaldirir. Yetki verilirse
# Actions da calisir, ikisi de idempotent (diff-upsert) — cakismaz.
#
# TASARIM:
#  - SADECE main'e push'ta calisir. Feature dal/worktree push'unda calissaydi,
#    birlesmemis urunler D1'e girer ve Ege onlari musteriye onerirdi.
#  - urunler.json degismediyse hic calismaz (push'u yavaslatmaz).
#  - 🔴 FAIL-CLOSED (12 Agu 2026, K85): urunler.json DEGISTIYSE ve senkron
#    kosamaz/basarisiz olursa PUSH DURUR. Gerekce: fail-open hali urun alani
#    duzenlemesinin D1 senkronu OLMADAN main'e girmesine izin veriyordu (ayni
#    urun ayni gun IKINCI kez uzlastiriciyi kirmizi yakti; aradaki pencerede Ege
#    bayat katalog goruyordu = sessiz satis kaybi). D1 gecici arzasi varsa
#    duzeltilip TEKRAR push edilir — drift'in dogmasi onlenir.
#  - Bu dosya git'e GIRMEZ (.git/hooks commit'lenmez) — CLAUDE.md'de yazili.
#
# 🔴 KAYNAK = PUSH EDILEN COMMIT (9 Agu 2026 onarimi; ONCESI: bayraksiz cagri).
# d1-sync BAYRAKSIZ kosarsa katalogu CALISMA AGACINDAKI urunler.json'dan okur. Bes
# ev (KraL · MaCiT · KaaN · ArTisT · HocA) ayni checkout'u paylasiyor: baska bir
# oturumun YARIM parti urun degisikligi agacta dururken BU push senkronu tetiklerse
# o yarim parti CANLI D1'e (Ege'nin okudugu katalog) yazilir — ve hicbir sey kirmizi
# yakmaz, push YESIL doner. Bayatlik kapisi COMMIT GRAFIGINI olcer, agacin o
# commit'ten SAPMASINI olcmez. Artik senkron PUSH EDILEN AGACI okur:
#   push edilen sha == HEAD  -> `--head`   (d1-sync `git show HEAD:urunler.json`)
#   push edilen sha != HEAD  -> `--kaynak` (o commit'ten cikarilan gecici dosya;
#                               or. `git push origin dal:main` — HEAD baska yerde;
#                               `--head` orada YANLIS agaci okurdu, koprulendi)
# FAIL-CLOSED (kol DURUR, calisma agacina DUSMEZ): katalog push edilen commit'ten
# cikarilamazsa senkron HIC kosmaz — sessizce agaca dusmek, kapatilan hatanin ta
# kendisi olurdu. Kolun DURMASI push'u bloklamaz (bu blok fail-open'dir).
# Kabul testi: python3 tools/prepush-d1-kaynak-test.py (GERCEK push + kontrol mutanti).

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
sync="$root/tools/d1-sync.py"
[ -f "$sync" ] || exit 0

sifir="0000000000000000000000000000000000000000"
degisti=0
push_sha=""

# pre-push stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue   # sadece main
  [ "$local_sha" = "$sifir" ] && continue             # dal siliniyor
  push_sha="$local_sha"                               # main'e GIDEN commit
  if [ "$remote_sha" = "$sifir" ]; then
    degisti=1                                         # yeni dal: taban yok -> senkronla
  else
    # cikis 0=ayni, 1=farkli, >1=hata. Hatada da senkronla (emin olamiyorsak calis).
    git diff --quiet "$remote_sha" "$local_sha" -- urunler.json 2>/dev/null || degisti=1
  fi
done

[ "$degisti" = "0" ] && exit 0

# KATALOG KAYNAGINI SEC (bkz. yukaridaki blok). "$@" = d1-sync bayraklari.
head_sha=$(git rev-parse HEAD 2>/dev/null)
kaynak_gecici=""
if [ -n "$push_sha" ] && [ "$push_sha" = "$head_sha" ]; then
  set -- --head
else
  kaynak_gecici=$(mktemp 2>/dev/null || echo /tmp/pruvo-d1-kaynak-$$.json)
  if git show "$push_sha:urunler.json" > "$kaynak_gecici" 2>/dev/null; then
    set -- --kaynak "$kaynak_gecici"
  else
    rm -f "$kaynak_gecici"
    echo "!! PUSH DURDURULDU — D1 SENKRONU KOSULAMADI: push edilen commit'ten"
    echo "!! ($push_sha) urunler.json cikarilamadi. Calisma agacina DUSULMEZ"
    echo "!! (commit'lenmemis urunler CANLI katalogda gorunmemeli)."
    echo "!! Elle: python3 $sync --kaynak <dosya>   (sonra tekrar push et)"
    exit 1
  fi
fi

echo "→ urunler.json degisti: D1 senkronlaniyor (Ege urunleri D1'den okuyor)..."
if ! python3 "$sync" "$@"; then
  echo "!! PUSH DURDURULDU — D1 SENKRONU BASARISIZ."
  echo "!! urunler.json main'e girmek uzereydi ama D1 bayat kaldi; Ege (WhatsApp)"
  echo "!! urunleri D1'den okudugu icin musteriye BAYAT/YANLIS katalog gosterilir"
  echo "!! (sessiz satis kaybi — K85). Duzeltip tekrar push et:  python3 $sync"
  echo "!! (Kontrol: python3 $sync --durum  -> sayi urunler.json ile ayni olmali)"
  [ -n "$kaynak_gecici" ] && rm -f "$kaynak_gecici"
  exit 1
fi
[ -n "$kaynak_gecici" ] && rm -f "$kaynak_gecici"

# --- KAPAK THUMBNAIL URETIMI (yeni urun eklendikce otomatik) ---
# 🔴 KAYNAK: paralel `pagespeed-thumb-fix` oturumu (a7dd82ba, HENUZ main'de DEGIL).
# Canli `.git/hooks/pre-push`ta duruyordu; kurulum izlenen kaynaga gecince blok
# dusmesin diye BURAYA TASINDI. `tools/thumbnail-uret.py` main'de yok -> `[ -f ]`
# kapisi bunu SESSIZCE atlar (zararsiz); pagespeed-thumb-fix main'e inince
# etkinlesir. SIRA KOORDINASYONU GEREKEBILIR (o dal aktifse iki taraf ayni blogu
# tasir; merge'te cakismaz ama tekrar dusmesin).
# NEDEN VAR: kart gridi kucuk "-thumb" R2 varyantini deniyor (bkz index.html
# thumbUrl()). Bu adim olmazsa YENI eklenen urunlerin kapaginda thumb hic uretilmez,
# kart sessizce orijinal buyuk gorseli ceker (PageSpeed bulgusu geri gelir).
# Idempotent (R2'de VARSA atlar) -> ucuz, yalniz yeni kapaklari isler.
# FAIL-OPEN: patlasa/Pillow eksik olsa bile push ASLA durmaz (D1 blogu ile ayni desen).
thumb="$root/tools/thumbnail-uret.py"
if [ -f "$thumb" ]; then
  echo "→ kapak thumbnail'leri uretiliyor (yalniz yeni urunler)..."
  if python3 "$thumb"; then
    :
  else
    echo "!! THUMBNAIL URETIMI BASARISIZ — push DEVAM ediyor ama yeni urunlerin karti buyuk gorsel cekebilir."
    echo "!! Duzeltip elle calistir:  python3 $thumb"
  fi
fi

exit 0

#!/bin/sh
# PRUVO pre-commit — IZLENEN KANCA KAYNAGI (tools/kancalar/pre-commit).
# Kurulum: python3 tools/kanca-kur.py
#   -> izlenen tools/kancalar ORTAK `.git/pruvo-kancalar/`a KOPYALANIR ve
#      core.hooksPath o kopyanin MUTLAK yoluna baglanir (agactan bagimsiz kosar).
# Nobetci: python3 tools/kanca-kablolama-nobeti.py
#
# 🔴 4 AGU 2026 ONARIMI — UC AYRI FAIL-OPEN KAPATILDI.
# Bu kanca `.git/hooks/pre-commit` olarak yasarken govdesi soyleydi:
#     root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
#     [ -f "$guard" ] || exit 0
#     python3 "$guard" --tetik commit >/dev/null 2>&1 || true
# Yani (a) kok cozulemezse TUM kanca sessizce atlaniyordu, (b) guard dosyasi
# yoksa mukerrer kontrolu ve mimar kapisi DAHIL her sey atlaniyordu, (c) guard
# reddetse bile `|| true` cikis kodunu, `>/dev/null 2>&1` ise GEREKCEYI yutuyordu.
# Bu arada `tools/urunler-guard.py` FAIL-LOUD bir nobetciye cevrilmisti (sifir-disi
# cikis + stderr'e gerekce) — ama git tarafinda o cikis kodunu KIMSE OKUMUYORDU.
# Koruma yalniz bu makinenin oturum kablosuyla (PreToolUse) blokluyordu; duz
# terminalde, Codex'te ve baska bir makinede BLOKLAMIYORDU.
#
# KURAL: bu kancadaki her nobetci FAIL-CLOSED'dir — kosturulamayan nobetci
# "sorun yok" DEMEK DEGILDIR, commit DURUR ve NEDENI BASILIR.
# Kasten atlamak icin:  git commit --no-verify
# (--no-verify'a karsi asil koruma harness PreToolUse hook'udur.)

pruvo_kok=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$pruvo_kok" ]; then
  echo "!! COMMIT DURDURULDU — depo koku cozulemedi (git rev-parse basarisiz)." >&2
  echo "!! Hicbir katalog/gizlilik nobetcisi kosturulamadi; sessiz gecis YOK." >&2
  exit 1
fi

# --- 0) KOPYA TAZELIGI (FAIL-CLOSED, DELIK 1) -------------------------------
# Kurulum izlenen kaynagi ORTAK `.git/pruvo-kancalar/`a kopyalar. `git pull`
# izlenen kaynagi guncelleyince bu KOPYA bayat kalir ve BU KANCA (kopyadan
# kosan) SESSIZCE eski mantigi calistirir. `--tazele` kopya bayatsa yeniden
# serer; rc 3 = "bayatti+tazelendi" -> commit'i DURDUR, sonraki commit taze
# mantikla kosar. (Kaynak yoksa/guncelse rc 0 -> devam.)
pruvo_kur="$pruvo_kok/tools/kanca-kur.py"
if [ -f "$pruvo_kur" ]; then
  python3 "$pruvo_kur" --tazele
  pruvo_tazele_rc=$?
  if [ "$pruvo_tazele_rc" = "3" ]; then
    echo "!! COMMIT DURDURULDU — kurulu kanca kopyasi BAYATTI ve tazelendi." >&2
    echo "!! Commit'i TEKRAR dene (bu sefer guncel mantik kosar)." >&2
    exit 1
  elif [ "$pruvo_tazele_rc" != "0" ]; then
    echo "!! COMMIT DURDURULDU — kanca kopyasi tazelenemedi (rc=$pruvo_tazele_rc)." >&2
    exit 1
  fi
fi

# --- 1) urunler.json PROVENANS GUARD'i (FAIL-CLOSED) ------------------------
# Sifir-disi cikis = guard REDDETTI (bozuk JSON, cozulemeyen provenans, izinsiz
# degisim...). Cikti YUTULMAZ: mimar "neden durdu"yu ekrandan okur.
pruvo_guard="$pruvo_kok/tools/urunler-guard.py"
if [ ! -f "$pruvo_guard" ]; then
  echo "!! COMMIT DURDURULDU — tools/urunler-guard.py YOK." >&2
  echo "!! Katalog korumasi OLCULEMEDI; olculemeyen sey yesil sayilmaz." >&2
  exit 1
fi
python3 "$pruvo_guard" --tetik commit
pruvo_guard_rc=$?
if [ "$pruvo_guard_rc" -ne 0 ]; then
  echo "!! COMMIT DURDURULDU — urunler.json guard'i REDDETTI (rc=$pruvo_guard_rc)." >&2
  echo "!! Gerekce yukarida. Mesru duzeltme yolu: python3 tools/duzelt.py" >&2
  exit 1
fi

# --- 2) MUKERRER taramasi (FAIL-CLOSED) -------------------------------------
# Ayni id / birebir ayni baslik / ayni kaynak linki commit'i BLOKLAR.
# Istisna: .mukerrer-istisna.json. Acil atlama: PRUVO_MUKERRER_ATLA=1
pruvo_kontrol="$pruvo_kok/tools/mukerrer-kontrol.py"
if [ "$PRUVO_MUKERRER_ATLA" = "1" ]; then
  echo "!! UYARI: PRUVO_MUKERRER_ATLA=1 — mukerrer taramasi ATLANDI (bilincli)." >&2
elif [ ! -f "$pruvo_kontrol" ]; then
  echo "!! COMMIT DURDURULDU — tools/mukerrer-kontrol.py YOK." >&2
  echo "!! Mukerrer korumasi OLCULEMEDI. Atlamak icin: PRUVO_MUKERRER_ATLA=1" >&2
  exit 1
else
  pruvo_mk_cikti=$(python3 "$pruvo_kontrol" 2>&1)
  pruvo_mk_rc=$?
  if [ "$pruvo_mk_rc" -ne 0 ]; then
    printf '%s\n' "$pruvo_mk_cikti" >&2
    echo "!! COMMIT ENGELLENDI — mukerrer taramasi rc=$pruvo_mk_rc." >&2
    echo "!! Mesru cift ise .mukerrer-istisna.json'a ekle; acil atlama: PRUVO_MUKERRER_ATLA=1" >&2
    exit 1
  fi
fi

# --- 3) MIMAR KOD-KILIDI git backstop (FAIL-CLOSED) -------------------------
# Ana repo'dan kaynak/veri commit'i worker onayi (PRUVO_MIMAR_ONAY=worker)
# yoksa BLOKLANIR. Worktree'den serbest (kapinin kendi hukmu).
pruvo_gate="$pruvo_kok/tools/mimar-commit-kapisi.py"
if [ ! -f "$pruvo_gate" ]; then
  echo "!! COMMIT DURDURULDU — tools/mimar-commit-kapisi.py YOK." >&2
  echo "!! Mimar kod-kilidi backstop'u OLCULEMEDI." >&2
  exit 1
fi
python3 "$pruvo_gate" || exit 1

# --- 4) DIRILTME KAPISI — YAZIM ONCESI kol (FAIL-CLOSED) --------------------
# 🔴 6 AGU 2026 ONARIMI — "TEK ATIMLIK SONME" SINIFI KAPATILDI (olculdu):
#   `c912548f` bir kaydi feed politikasi gerekcesiyle katalogdan CIKARDI.
#   `841aab67` toplu ekleme partisi onu GERI DIRILTTI; tools/diriltme-kapisi.py
#   o push'ta CI'da (deploy.yml) KIRMIZI yandi ve deploy ATLANDI. AMA bir
#   sonraki push'ta (`d95f6f13`) KENDILIGINDEN YESILE dondu:
#       silinmis = ever_seen - <taban>'daki id'ler
#   Diriltme COMMIT'LENDIGI an bir sonraki koşumun TABANI o id'yi ICERIR, id
#   "silinmis" olmaktan CIKAR ve alarm SONER. Yani CI kolu tek atimliktir:
#   ihlal repoda KALIR, kapi susar. Kayit elle geri cikarildi ama SINIF acikti.
#   Ayrica huninin YAZIM ONCESI hicbir katmani (urunler-guard.py,
#   mukerrer-kontrol.py, parti-kontrol.py, urun-ekle.py) "bir zamanlar vardi ve
#   CIKARILDI" kumesine BAKMIYOR; hepsi guncel kataloga/HEAD'e bakiyor.
#   Bu adim ihlali COMMIT ANINDA durdurur -> diriltme repoya HIC girmez, dolayisi
#   ile "taban ihlali yutar" mekanizmasi hic devreye giremez.
#
# ON-ELEME (maliyet): kapi TAM gecmisi tarar (olculdu 6 Agu: ~200 MB diff,
#   ~5,1 s). urunler.json HEAD'e gore DEGISMEMISSE tarama KOSMAZ. Atlama
#   SESSIZ DEGIL: nedeni her seferinde BASILIR (sessiz atlama = sessiz yesil).
# OLCUM EKSENI: kapinin `--calisma-agaci` kipi HEAD -> CALISMA AGACI olcer;
#   on-eleme de AYNI ekseni (git diff HEAD) kullanir ki kapsam ile on-eleme
#   ayrisip sessiz delik acmasin ([[kabul-araligi-karsilastirma-araligi]]).
# rc=2 (OLCULEMEDI) YESIL SAYILMAZ -> commit DURUR.
pruvo_diriltme="$pruvo_kok/tools/diriltme-kapisi.py"
if [ ! -f "$pruvo_diriltme" ]; then
  echo "!! COMMIT DURDURULDU — tools/diriltme-kapisi.py YOK." >&2
  echo "!! Diriltme korumasi OLCULEMEDI; olculemeyen sey yesil sayilmaz." >&2
  exit 1
fi
if ! git rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
  echo "-- diriltme kapisi ATLANDI: HEAD YOK (ilk commit) — karsilastirilacak taban yok." >&2
elif [ ! -f "$pruvo_kok/urunler.json" ]; then
  echo "-- diriltme kapisi ATLANDI: urunler.json calisma agacinda YOK." >&2
else
  git diff --quiet HEAD -- urunler.json
  pruvo_dir_fark=$?
  if [ "$pruvo_dir_fark" = "0" ]; then
    echo "-- diriltme kapisi ATLANDI: urunler.json HEAD'e gore DEGISMEDI (on-eleme)." >&2
  elif [ "$pruvo_dir_fark" = "1" ]; then
    python3 "$pruvo_diriltme" --calisma-agaci
    pruvo_dir_rc=$?
    if [ "$pruvo_dir_rc" -ne 0 ]; then
      echo "!! COMMIT DURDURULDU — diriltme kapisi rc=$pruvo_dir_rc (0=YESIL 1=KIRMIZI 2=OLCULEMEDI)." >&2
      echo "!! Gerekce yukarida. Mesru geri alma: .diriltme-izin.json'a GEREKCEYLE yaz" >&2
      echo "!!   kayit ekseni -> \"<id>\"   ·   alan ekseni -> \"<id>#<alan>\"" >&2
      exit 1
    fi
  else
    echo "!! COMMIT DURDURULDU — 'git diff HEAD -- urunler.json' rc=$pruvo_dir_fark;" >&2
    echo "!! on-eleme OLCULEMEDI, olculemeyen sey yesil sayilmaz." >&2
    exit 1
  fi
fi

# --- 5) KATALOG ALAN KAPISI — `altkategori` + `uyum`/`marka` (FAIL-CLOSED) ---
# 🔴 8 AGU 2026 ONARIMI — "YAZIM YOLU KAPIYI ATLIYOR" SINIFI KAPATILDI (olculdu):
#   Toplu ekleme yolu urunler.json'a DOGRUDAN yaziyor ve tools/duzelt.py'nin IKI
#   fail-closed kapisini birden atliyordu (_altkategori_ihlalleri -> altkategori_sebebi,
#   _uyum_ihlalleri -> uyum_sebebi/K5 ikiz tanimi). Bir partide 5 kayit bozuk main'e
#   girdi; ariza SAATLER SONRA CI serit-a2'de gorundu, deploy ATLANDI (3,5+ saat).
#   Kapilar YALNIZ duzelt.py'nin ICINDE ve YALNIZ CI'da yasiyordu -> yazim yolunda
#   hicbir kol yoktu. Bu adim ihlali COMMIT ANINDA durdurur: repoya HIC girmez.
# TEK KAYNAK: kapi kurali kopyalamaz, arama.altkategori_sebebi / arama.uyum_sebebi
#   fonksiyonlarini cagirir.
# ON-ELEME KABUKTA YAPILMAZ: kapinin ekseni INDEX'tir; burada `git diff --quiet HEAD`
#   ile eleseydik CALISMA AGACI ekseni acilir ve iki eksen sessizce ayrisirdi (adim 4'un
#   ekseni bilerek AYRIDIR). On-eleme kapinin KENDI icinde, AYNI index ekseninde kosar
#   ve atlama nedeni her seferinde BASILIR ([[kabul-araligi-karsilastirma-araligi]]).
# rc=2 (OLCULEMEDI) YESIL SAYILMAZ -> commit DURUR.
pruvo_alan="$pruvo_kok/tools/katalog-alan-kapisi.py"
if [ ! -f "$pruvo_alan" ]; then
  echo "!! COMMIT DURDURULDU — tools/katalog-alan-kapisi.py YOK." >&2
  echo "!! altkategori/uyum korumasi OLCULEMEDI; olculemeyen sey yesil sayilmaz." >&2
  exit 1
fi
python3 "$pruvo_alan"
pruvo_alan_rc=$?
if [ "$pruvo_alan_rc" -ne 0 ]; then
  echo "!! COMMIT DURDURULDU — katalog alan kapisi rc=$pruvo_alan_rc (0=YESIL 1=KIRMIZI 2=OLCULEMEDI)." >&2
  echo "!! Gerekce yukarida. Mesru yazma yolu: python3 tools/duzelt.py" >&2
  exit 1
fi

# --- 6) DEVAM SINIF KAPISI — INDEX (COMMIT ANI) kolu (FAIL-CLOSED) ----------
# 🔴 9 AGU 2026 ONARIMI — "DEFTER IHLALI YAYINI DURDURUYOR" SINIFI (olculdu):
#   `bdddaee0` izlenen kok defterine bir E5 (kapi-bypass) satiri soktu. Kapi
#   DOGRU calisti ama YALNIZ CI'da yasiyordu: `serit-a2` + `serit-a3` kirmizi
#   yandi, `deploy` + `yayin` SKIPPED kaldi ve yayin ~1 SAAT durdu. Ihlal
#   defterden arsive tasininca kapi kendiliginden yesile dondu — yani maliyet
#   ihlalin buyuklugunden degil YAKALANDIGI YERDEN geliyordu. Bu adim ihlali
#   COMMIT ANINDA durdurur: main'e HIC girmez, yayini HIC durduramaz.
#   (Adim 5 ile AYNI sinif, KATALOG yerine DEFTER duzleminde.)
# EKSEN INDEX'TIR, CALISMA AGACI DEGIL: bu checkout'u BES ev paylasir; calisma
#   agacini yargilayan bir kol, baska bir oturumun yarim DEVAM.md taslagi
#   yuzunden HERKESIN commit'ini kilitlerdi ([[kanca-stage-disi-agaci-tarar]]).
# ON-ELEME KAPININ ICINDE, AYNI INDEX EKSENINDE: kabukta `git diff HEAD` ile
#   elenseydi iki eksen sessizce ayrisirdi ([[kabul-araligi-karsilastirma-araligi]]).
#   Atlama nedeni her seferinde BASILIR (sessiz atlama = sessiz yesil).
# CI KOLU YERINDE KALIR: kancalar commit EDILMEZ ve atlanabilir; ZORLAYICI
#   hukum `serit-a2`dedir. Bu kol onun YERINE GECMEZ, ONUNDE DURUR.
# rc=2 (OLCULEMEDI) YESIL SAYILMAZ -> commit DURUR.
pruvo_devam="$pruvo_kok/tools/devam-sinif-kapisi.py"
if [ ! -f "$pruvo_devam" ]; then
  echo "!! COMMIT DURDURULDU — tools/devam-sinif-kapisi.py YOK." >&2
  echo "!! Defter icerik-sinifi korumasi OLCULEMEDI; olculemeyen sey yesil sayilmaz." >&2
  exit 1
fi
python3 "$pruvo_devam" --index
pruvo_devam_rc=$?
if [ "$pruvo_devam_rc" -ne 0 ]; then
  echo "!! COMMIT DURDURULDU — defter sinif kapisi rc=$pruvo_devam_rc (0=YESIL 1=KIRMIZI 2=OLCULEMEDI)." >&2
  echo "!! Gerekce yukarida. COZUM: ihlal eden satirlari DEVAM-ARSIV.md'ye (git DISI)" >&2
  echo "!!   TASI, deftere notr tek satirlik isaretci birak. Silme YOK, tasima VAR." >&2
  exit 1
fi

# --- 7) IC RAPOR ADI KAPISI — INDEX (COMMIT ANI) kolu (FAIL-CLOSED) ----------
# 🔴 12 AGU 2026 ONARIMI — ADIM 6 ILE AYNI SINIFIN IKINCI VAKASI (olculdu):
#   Bir nobet turu ic isci-raporunun protokol adini IZLENEN kok defter DEVAM.md'ye
#   birebir yazdi (satir 206 + 214). tools/ic-rapor-adi-kapisi.py DOGRU calisti ama
#   YALNIZ CI'da yasiyordu: kosum 31549865286'da `serit-a3` KIRMIZI yandi, `deploy`
#   + `yayin` SKIPPED kaldi ve YAYIN DURDU; kanama 3383aa90 ile durduruldu.
#   `grep -rn ic-rapor-adi-kapisi tools/kancalar/` -> 0 isabet: kapi deploy.yml
#   (2 cagri) + nobet.yml (2 cagri) disinda hicbir yerde yoktu, yani defteri yazan
#   kisi ihlali ANCAK YAYIN DURDUKTAN SONRA ogreniyordu. Maliyet ihlalin
#   BUYUKLUGUNDEN degil YAKALANDIGI YERDEN geliyor. Bu adim ihlali COMMIT ANINDA
#   durdurur: main'e HIC girmez, yayini HIC durduramaz.
# EKSEN INDEX'TIR, CALISMA AGACI DEGIL: bu checkout'u BES ev paylasir; kanonik
#   kapinin BAYRAKSIZ kolu TUM izlenen CALISMA AGACINI tarar ve oldugu gibi
#   baglansaydi baska bir oturumun STAGE'LENMEMIS yarim DEVAM.md taslagi HERKESIN
#   commit'ini kilitlerdi ([[kanca-stage-disi-agaci-tarar]]). tools/ic-rapor-index-
#   kolu.py o kapinin INDEX izdusumudur: hukum/desen/muafiyet govdesi KOPYALANMAZ,
#   kanonik kapidan IMPORT edilir ve KENDI kirmizi-yesil sozlesmesiyle canliligi
#   sinanir ([[ikiz-tanim-sessiz-ayrisma]]).
# ON-ELEME KAPININ ICINDE, AYNI INDEX EKSENINDE: kabukta `git diff HEAD` ile
#   elenseydi iki eksen sessizce ayrisirdi ([[kabul-araligi-karsilastirma-araligi]]).
#   Atlama nedeni her seferinde BASILIR (sessiz atlama = sessiz yesil).
# CI KOLU YERINDE KALIR: kancalar commit EDILMEZ ve atlanabilir; ZORLAYICI hukum
#   deploy.yml serit-a3'tedir. Bu kol onun YERINE GECMEZ, ONUNDE DURUR. Kancanin
#   GORMEDIGI kalici durumu (uzak dallar, kancasiz makineler) `--uzak` kolu olcer.
# rc=2 (OLCULEMEDI) YESIL SAYILMAZ -> commit DURUR.
pruvo_icrapor="$pruvo_kok/tools/ic-rapor-index-kolu.py"
if [ ! -f "$pruvo_icrapor" ]; then
  echo "!! COMMIT DURDURULDU — tools/ic-rapor-index-kolu.py YOK." >&2
  echo "!! Ic rapor adi korumasi OLCULEMEDI; olculemeyen sey yesil sayilmaz." >&2
  exit 1
fi
python3 "$pruvo_icrapor"
pruvo_icrapor_rc=$?
if [ "$pruvo_icrapor_rc" -ne 0 ]; then
  echo "!! COMMIT DURDURULDU — ic rapor adi kapisi INDEX kolu rc=$pruvo_icrapor_rc (0=YESIL 1=KIRMIZI 2=OLCULEMEDI)." >&2
  echo "!! Kanonik hukum: tools/ic-rapor-adi-kapisi.py (CI'da serit-a3'te BLOKLAYICI)." >&2
  echo "!! Gerekce yukarida. COZUM: yorum/docstring METNINDEN ic rapor dosya adini" >&2
  echo "!!   kaldir, anlamini koruyan genel ifadeyle yaz (or. 'muhendis raporunda');" >&2
  echo "!!   defter satiriysa DEVAM-ARSIV.md'ye (git DISI) TASI. Silme YOK, tasima VAR." >&2
  exit 1
fi

exit 0
